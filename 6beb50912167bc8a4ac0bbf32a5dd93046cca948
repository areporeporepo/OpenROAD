9,115,22,0.15)\" stroke=\"rgba(249,115,22,0.4)\" stroke-width=\"1\"/>\n          <text x=\"40\" y=\"16\" text-anchor=\"middle\" fill=\"#f97316\" font-size=\"10\" font-family=\"monospace\">Chamfer</text>\n          <text x=\"40\" y=\"28\" text-anchor=\"middle\" fill=\"#666\" font-size=\"8\" font-family=\"monospace\">size=3mm</text>\n        </g>\n        <g class=\"param-node\" transform=\"translate(100,185)\">\n          <rect width=\"80\" height=\"36\" rx=\"6\" fill=\"rgba(236,72,153,0.15)\" stroke=\"rgba(236,72,153,0.4)\" stroke-width=\"1\"/>\n          <text x=\"40\" y=\"16\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"10\" font-family=\"monospace\">Fillet</text>\n          <text x=\"40\" y=\"28\" text-anchor=\"middle\" fill=\"#666\" font-size=\"8\" font-family=\"monospace\">radius=2mm</text>\n        </g>\n        <g class=\"param-node\" transform=\"translate(240,185)\">\n          <rect width=\"80\" height=\"36\" rx=\"6\" fill=\"rgba(236,72,153,0.15)\" stroke=\"rgba(236,72,153,0.4)\" stroke-width=\"1\"/>\n          <text x=\"40\" y=\"16\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"10\" font-family=\"monospace\">Pattern</text>\n          <text x=\"40\" y=\"28\" text-anchor=\"middle\" fill=\"#666\" font-size=\"8\" font-family=\"monospace\">count=4</text>\n        </g>\n        <g class=\"param-node\" transform=\"translate(160,262)\">\n          <rect width=\"80\" height=\"36\" rx=\"6\" fill=\"rgba(255,255,255,0.1)\" stroke=\"rgba(255,255,255,0.3)\" stroke-width=\"1.5\"/>\n          <text x=\"40\" y=\"16\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\">Final Shape</text>\n          <text x=\"40\" y=\"28\" text-anchor=\"middle\" fill=\"#888\" font-size=\"8\" font-family=\"monospace\">B-Rep solid</text>\n        </g>\n\n        <!-- Cascade annotation -->\n        <text x=\"220\" y=\"165\" class=\"cascade-text\" text-anchor=\"middle\" font-family=\"monospace\">change Sketch_1 width</text>\n      