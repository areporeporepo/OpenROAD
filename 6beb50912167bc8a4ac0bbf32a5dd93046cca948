ById('m4-routes');\n  for (let i = 0; i < 40; i++) {\n    const route = document.createElement('div');\n    route.className = 'route-v';\n    route.style.left = (5 + Math.random() * 90) + '%';\n    route.style.top = (Math.random() * 30) + '%';\n    route.style.height = (20 + Math.random() * 60) + '%';\n    route.style.background = `rgba(255,80,80,${0.15 + Math.random() * 0.35})`;\n    m4.appendChild(route);\n  }\n\n  // M5: Power grid\n  const m5 = document.getElementById('m5-power');\n  for (let i = 0; i < 12; i++) {\n    const route = document.createElement('div');\n    route.className = 'route-h';\n    route.style.top = (i * 9 + 2) + '%';\n    route.style.left = '0';\n    route.style.width = '100%';\n    route.style.height = '3px';\n    route.style.background = `rgba(200,50,255,${0.2 + (i % 3 === 0 ? 0.3 : 0)})`;\n    m5.appendChild(route);\n  }\n  for (let i = 0; i < 12; i++) {\n    const route = document.createElement('div');\n    route.className = 'route-v';\n    route.style.left = (i * 9 + 2) + '%';\n    route.style.top = '0';\n    route.style.height = '100%';\n    route.style.width = '3px';\n    route.style.background = `rgba(200,50,255,${0.2 + (i % 3 === 0 ? 0.3 : 0)})`;\n    m5.appendChild(route);\n  }\n\n  // Vias between layers\n  const stack = document.getElementById('chipStack');\n  for (let i = 0; i < 25; i++) {\n    const via = document.createElement('div');\n    via.className = 'via';\n    via.style.left = (50 + Math.random() * 280) + 'px';\n    via.style.top = (50 + Math.random() * 280) + 'px';\n    via.style.transform = `translateZ(${Math.random() * 160}px)`;\n    via.style.animationDelay = (Math.random() * 2) + 's';\n    stack.appendChild(via);\n  }\n}\n\npopulateChip();\n</script>\n</body>\n</html>\n",
